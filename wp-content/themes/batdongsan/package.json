{
  "name": "batdongsan-theme",
  "version": "1.0.0",
  "description": "WordPress theme for BatDongSan with Tailwind CSS",
  "scripts": {
    "dev": "postcss src/input.css -o assets/css/tailwind.css --watch",
    "watch": "postcss src/input.css -o assets/css/tailwind.css --watch",
    "tw:dev": "postcss src/input.css -o assets/css/tailwind.css --watch",
    "tw:watch": "postcss src/input.css -o assets/css/tailwind.css --watch",
    "tw:build": "postcss src/input.css -o assets/css/tailwind.css",
    "build:css": "npm run tw:build && cat style.css assets/css/components.css assets/css/tailwind.css | npx esbuild --minify --loader=css > assets/css/main.min.css",
    "build:js": "npx esbuild js/main.js --minify --outfile=js/main.bundle.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cssnano": "^8.0.10",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.0.0"
  }
}
